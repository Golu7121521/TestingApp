<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="12dp">

    <!-- Portrait (9:16 jaisa) Short thumbnail -->
    <ImageView
        android:id="@+id/img_short_thumb"
        android:layout_width="match_parent"
        android:layout_height="290dp"
        android:background="@color/yt_surface"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/txt_short_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/yt_white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_short_views"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/yt_gray_text"
        android:textSize="11sp" />
</LinearLayout>
