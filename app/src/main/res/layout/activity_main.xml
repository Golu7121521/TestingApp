<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Top Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1E1E1E"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MT Manager Lite (Dual-Pane)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnRootToggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Root: OFF"
            android:textSize="12sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- Dual Pane Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Pane -->
        <FrameLayout
            android:id="@+id/paneLeft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#181818"/>

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="#333333"/>

        <!-- Right Pane -->
        <FrameLayout
            android:id="@+id/paneRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#181818"/>

    </LinearLayout>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#1E1E1E"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="4">

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Copy"
            android:textSize="12sp"
            android:backgroundTint="#2D2D2D"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnMove"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Move"
            android:textSize="12sp"
            android:backgroundTint="#2D2D2D"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnZip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Zip"
            android:textSize="12sp"
            android:backgroundTint="#2D2D2D"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Delete"
            android:textSize="12sp"
            android:backgroundTint="#4A2020"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</LinearLayout>
