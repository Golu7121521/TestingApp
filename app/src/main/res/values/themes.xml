<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose handles the actual theme; this only sets the window background
         so there is no white flash before the first frame. -->
    <style name="Theme.StreamX" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0F0F0F</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
