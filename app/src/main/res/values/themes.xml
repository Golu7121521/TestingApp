<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NewTube" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/yt_red</item>
        <item name="colorPrimaryVariant">@color/yt_black</item>
        <item name="colorOnPrimary">@color/yt_white</item>
        <item name="android:statusBarColor">@color/yt_black</item>
        <item name="android:navigationBarColor">@color/yt_black</item>
        <item name="android:windowBackground">@color/yt_black</item>
    </style>

    <style name="BottomNavTextActive" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/yt_white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BottomNavTextInactive" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/yt_gray_text</item>
    </style>
</resources>
